{
  "name": "blesscupid",
  "private": true,
  "version": "0.0.1",
  "description": "BlessCupid — faith-first dating app for Christians and Catholics",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "setup": "pnpm install && pnpm -r run prepare || true",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mobile": "pnpm --filter @blesscupid/mobile",
    "api": "pnpm --filter @blesscupid/api",
    "shared": "pnpm --filter @blesscupid/shared"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "@types/node": "^20.16.10",
    "prettier": "^3.3.3"
  }
}
