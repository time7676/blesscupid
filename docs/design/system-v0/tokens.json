{
  "$schema": "https://style-dictionary.com/schemas/v3-tokens.json",
  "color": {
    "ink": {
      "default": { "value": "#1A1A24", "type": "color", "description": "Primary text + dark surface (tabbar active, dark CTA, home indicator)." },
      "soft":    { "value": "#3F3F4A", "type": "color", "description": "Secondary text, muted labels, helper copy." },
      "charcoal":{ "value": "#14181F", "type": "color", "description": "Cooler near-black from absorbed D3 neutrals. Use for monochrome surfaces where parchment is wrong (modal overlays, video controls)." }
    },
    "parchment": {
      "default": { "value": "#FAF7F0", "type": "color", "description": "Primary background. The cathedral light field." },
      "raised":  { "value": "#FFFDF7", "type": "color", "description": "Card surface above parchment. Subtle lift, no shadow." },
      "off":     { "value": "#F8F8F4", "type": "color", "description": "Cooler off-white from absorbed D3. Use for neutral surfaces that should not read warm (data displays, settings)." }
    },
    "sandstone": {
      "default": { "value": "#F4ECDF", "type": "color", "description": "Selectable surface (radio cards, secondary tiles)." },
      "deep":    { "value": "#EFE4D2", "type": "color", "description": "Pressed / hover state for sandstone." },
      "warm":    { "value": "#FBF3E2", "type": "color", "description": "Selected radio-card fill (gold hue, very low chroma)." }
    },
    "gold": {
      "default": { "value": "#C8A24B", "type": "color", "description": "Communion gold. Selection, accent, ornament. NOT a CTA color." },
      "soft":    { "value": "#E5C97D", "type": "color", "description": "Gold-tint highlight for backgrounds, never text." },
      "halo":    { "value": "rgba(200, 162, 75, 0.18)", "type": "color", "description": "Pip glow, focus ring." }
    },
    "indigo": {
      "default": { "value": "#2A3470", "type": "color", "description": "Italic emphasis in serif headlines. Liturgical accent. Never on body text." }
    },
    "hairline": {
      "default": { "value": "rgba(26, 26, 36, 0.12)", "type": "color", "description": "1px dividers, default borders." },
      "soft":    { "value": "rgba(26, 26, 36, 0.06)", "type": "color", "description": "Whisper dividers, inside cards." },
      "strong":  { "value": "rgba(20, 24, 31, 0.16)", "type": "color", "description": "Stronger divider, used sparingly (table heads)." }
    },
    "feedback": {
      "warning": { "value": "#A95837", "type": "color", "description": "Soft terracotta for warnings — borrowed from D2 to keep a cross-tradition non-red alert. Used at 12% on bg." },
      "success": { "value": "#5C7A56", "type": "color", "description": "Sage green for completion confirmations. Restrained." }
    }
  },

  "font": {
    "family": {
      "serif":   { "value": "'Cormorant Garamond', 'EB Garamond', Georgia, serif", "type": "fontFamily", "description": "Display + emotional copy. Headlines, verses, CTA labels." },
      "sans":    { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "type": "fontFamily", "description": "UI + body + meta. Anything functional." },
      "mono":    { "value": "ui-monospace, SFMono-Regular, Menlo, monospace", "type": "fontFamily", "description": "Diagnostic + dev surfaces only. Not a customer-facing token." }
    },
    "weight": {
      "light":     { "value": 300, "type": "fontWeight" },
      "regular":   { "value": 400, "type": "fontWeight" },
      "medium":    { "value": 500, "type": "fontWeight" },
      "semibold":  { "value": 600, "type": "fontWeight" }
    },
    "size": {
      "hero":     { "value": "38px", "type": "fontSize", "description": "H1 / onboarding question / greeting." },
      "h2":       { "value": "26px", "type": "fontSize", "description": "Card headlines, profile name." },
      "h3":       { "value": "22px", "type": "fontSize", "description": "Verse, prompt-a, emphasis copy." },
      "body":     { "value": "14px", "type": "fontSize", "description": "Default body / helper." },
      "body-lg":  { "value": "16px", "type": "fontSize", "description": "Form-input value, paragraph emphasis." },
      "label":    { "value": "13px", "type": "fontSize", "description": "Form labels, secondary actions." },
      "caption":  { "value": "12.5px", "type": "fontSize", "description": "Sub-copy under list items." },
      "eyebrow":  { "value": "11px", "type": "fontSize", "description": "ALL-CAPS section labels (STEP 4 OF 10, TODAY)." }
    },
    "lineHeight": {
      "hero":    { "value": 1.04, "type": "lineHeight" },
      "h2":      { "value": 1.18, "type": "lineHeight" },
      "h3":      { "value": 1.35, "type": "lineHeight" },
      "body":    { "value": 1.55, "type": "lineHeight" },
      "tight":   { "value": 1.25, "type": "lineHeight" }
    },
    "tracking": {
      "tight":    { "value": "-0.012em", "type": "letterSpacing", "description": "Display + h2." },
      "normal":   { "value": "0",         "type": "letterSpacing" },
      "label":    { "value": "0.02em",    "type": "letterSpacing", "description": "Buttons, captions." },
      "eyebrow":  { "value": "0.2em",     "type": "letterSpacing", "description": "ALL-CAPS section labels." }
    }
  },

  "space": {
    "0":  { "value": "0px",   "type": "dimension" },
    "1":  { "value": "4px",   "type": "dimension" },
    "2":  { "value": "8px",   "type": "dimension" },
    "3":  { "value": "12px",  "type": "dimension" },
    "4":  { "value": "16px",  "type": "dimension" },
    "5":  { "value": "20px",  "type": "dimension" },
    "6":  { "value": "24px",  "type": "dimension" },
    "7":  { "value": "32px",  "type": "dimension" },
    "8":  { "value": "40px",  "type": "dimension" },
    "9":  { "value": "56px",  "type": "dimension" },
    "10": { "value": "72px",  "type": "dimension" }
  },

  "radius": {
    "none":  { "value": "0px",  "type": "dimension" },
    "xs":    { "value": "2px",  "type": "dimension", "description": "CTA button — squared off, intentional." },
    "sm":    { "value": "4px",  "type": "dimension", "description": "Radio card, reveal banner." },
    "md":    { "value": "6px",  "type": "dimension", "description": "Intention card." },
    "lg":    { "value": "12px", "type": "dimension", "description": "Form input." },
    "pill":  { "value": "999px","type": "dimension", "description": "Tradition badges, pip rails." },
    "circle":{ "value": "50%",  "type": "dimension", "description": "Avatars, icon buttons, radio markers." }
  },

  "border": {
    "width": {
      "thin":   { "value": "1px",  "type": "dimension" },
      "medium": { "value": "1.5px","type": "dimension", "description": "Radio marker stroke." },
      "thick":  { "value": "2px",  "type": "dimension" }
    }
  },

  "elevation": {
    "0": { "value": "none", "type": "shadow", "description": "Default. Cathedral Light prefers hairlines over shadow." },
    "raise": {
      "value": "0 1px 0 rgba(26, 26, 36, 0.04)",
      "type": "shadow",
      "description": "Subtle lift for cards above parchment."
    },
    "modal": {
      "value": "0 12px 32px rgba(20, 24, 31, 0.18)",
      "type": "shadow",
      "description": "Modal / sheet only."
    }
  },

  "motion": {
    "duration": {
      "instant":  { "value": "80ms",  "type": "duration", "description": "Color/opacity flicks." },
      "gentle":   { "value": "200ms", "type": "duration", "description": "Default UI transition (borders, fills)." },
      "intent":   { "value": "320ms", "type": "duration", "description": "Surface enter/leave, card reveal." },
      "ceremony": { "value": "560ms", "type": "duration", "description": "Reveal-the-day moment, intentional pause." }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.4, 0.0, 0.2, 1)", "type": "cubicBezier", "description": "Material standard. Default for entering/leaving UI." },
      "emphatic": { "value": "cubic-bezier(0.2, 0.7, 0.2, 1)", "type": "cubicBezier", "description": "Soft overshoot. Used on intent/ceremony durations." },
      "linear":   { "value": "linear",                          "type": "cubicBezier", "description": "Progress fills only." }
    },
    "preset": {
      "gentle":  { "value": "200ms cubic-bezier(0.4, 0.0, 0.2, 1)",  "type": "transition", "description": "Default. Border, fill, color." },
      "intent":  { "value": "320ms cubic-bezier(0.2, 0.7, 0.2, 1)",  "type": "transition", "description": "Card enter, reveal slide." },
      "ceremony":{ "value": "560ms cubic-bezier(0.2, 0.7, 0.2, 1)",  "type": "transition", "description": "Reveal moment. Use sparingly; never on routine UI." }
    }
  },

  "device": {
    "width":  { "value": "390px", "type": "dimension", "description": "iPhone reference width for v0 mockups." },
    "height": { "value": "844px", "type": "dimension", "description": "iPhone reference height for v0 mockups." },
    "homeIndicator": {
      "width":  { "value": "134px", "type": "dimension" },
      "height": { "value": "5px",   "type": "dimension" }
    }
  }
}
