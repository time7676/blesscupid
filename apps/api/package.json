{
  "name": "@blesscupid/api",
  "version": "0.1.1",
  "description": "BlessCupid API — auth, onboarding, profile, moderation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "echo 'lint: api (noop until eslint configured)'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node --import tsx/esm prisma/seed.ts",
    "seed:clean": "node --import tsx/esm prisma/seed-clean.ts",
    "seed:reviewers": "node --import tsx/esm prisma/seed-reviewers.ts",
    "seed:mock": "node --import tsx/esm prisma/seed-mock.ts",
    "worker:hard-delete": "node --import tsx/esm src/scripts/run-hard-delete-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1038.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@blesscupid/matching": "workspace:*",
    "@blesscupid/moderation": "workspace:*",
    "@blesscupid/shared": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^10.50.0",
    "argon2": "^0.41.1",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "posthog-node": "^5.30.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "xendit-node": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
