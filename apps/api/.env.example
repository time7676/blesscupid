DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blesscupid?schema=public
JWT_ACCESS_SECRET=replace-me-32-bytes
JWT_REFRESH_SECRET=replace-me-32-bytes
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# OAuth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=

# Moderation — Gemini default (cheapest tier). Set TEXT_MODERATION_PROVIDER
# to `openai` to fall back to omni-moderation-latest.
TEXT_MODERATION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
PERSPECTIVE_API_KEY=

# AWS Rekognition still uses AWS_REGION + AWS_ACCESS_*. Photo storage now
# accepts any S3-compatible backend (AWS S3 or Cloudflare R2).
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Photo storage. For Cloudflare R2 set S3_ENDPOINT + dedicated R2 keys; the
# client falls back to AWS S3 when S3_ENDPOINT is empty.
PHOTO_BUCKET=blesscupid-photos
# Cloudflare R2 — account 7e20a349cdb3379d8a786faaa993b371
S3_ENDPOINT=https://7e20a349cdb3379d8a786faaa993b371.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
