// BlessCupid API — Prisma schema
// Postgres. UUID PKs. Strict separation between auth identity and profile/faith data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Denomination {
  catholic
  protestant
  orthodox
  other
}

enum Gender {
  male
  female
}

enum MarriageIntent {
  within_1y
  within_2y
  within_5y
  open_timeline
}

enum ChurchAttendance {
  weekly
  monthly
  occasional
  rarely
}

enum SpiritualGift {
  teaching
  service
  mercy
  exhortation
  giving
  leadership
  evangelism
  hospitality
}

// BLE-124 — Q2 surface-routing intent.
enum Intent {
  dating
  friendship
  community
  unspecified
}

// BLE-124 — Q3 dating-side scope. `same_sex` is recorded only as a redirect
// outcome trigger; matching engine MUST NOT use it as a preference row
// (see Holy Code §4.2 / BLE-41 onboarding doc).
enum Seeking {
  woman
  man
  same_sex
  unspecified
}

// BLE-124 — Q4 expanded tradition self-ID. Stored alongside legacy
// `Denomination` for back-compat with FaithProfile.
enum Tradition {
  catholic
  protestant_evangelical
  protestant_pentecostal
  protestant_reformed
  protestant_mainline
  orthodox
  other_christian
  still_figuring
}

// BLE-124 — Q5 walk stage. Optional, never returned by public profile API.
enum WalkStage {
  lifelong
  came_later
  recent_convert
  returning
  doubting_exploring
  prefer_not_to_say
}

// BLE-124 — Q6 marriage open. `no` triggers friendship re-route flow.
enum MarriageOpen {
  yes
  maybe
  no
}

// BLE-124 — Q7 welcomed-group self-ID tags. Stored set; visibility is held
// in the per-tag map on `Profile.welcomedTagVisibility`.
enum WelcomedTag {
  previously_married
  single_parent
  widowed
  convert_from_non_christian
  church_hurt
}

// BLE-124 — Q8 faith practice rhythm. Match relevance only — explicit
// lint rule in services/matching forbids deprioritization based on these.
enum PracticeTag {
  sunday_in_person
  sunday_online
  catholic_mass
  daily_prayer
  small_group
  worship_at_home
  still_finding_a_community
}

// BLE-124 — Q3 redirect audit. Captures whether the user accepted the
// friendship re-route or chose to close the account. No tag stored on the
// user identity — Holy Code §4.2: scope, not identity.
enum Q3RedirectOutcome {
  accept_reroute
  closed_by_user
}

enum OAuthProvider {
  apple
  google
}

enum OnboardingStep {
  age_gate
  covenant
  faith_questionnaire
  profile_basics
  first_photo
  bio
  done
}

enum ModerationKind {
  text_bio
  text_message
  photo
}

enum ModerationDecision {
  allow
  review
  block
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum PhotoStatus {
  uploaded
  processing
  approved
  rejected
}

enum UserRole {
  member
  pastor
  ceo
}

enum MessageStatus {
  delivered
  queued
  blocked
}

enum ModerationQueueKind {
  text
  image
}

enum ModerationQueueStatus {
  pending_review
  approved
  rejected
}

enum ReportReason {
  sexual_content
  harassment
  off_platform_pressure
  scam_or_spam
  underage
  fake_profile
  other
}

enum ReportStatus {
  open
  under_review
  resolved
  dismissed
}

enum ModerationActionKind {
  dismiss
  warn
  suspend
  ban
}

enum AccountDeletionStatus {
  soft_deleted
  hard_deleted
  cancelled
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  passwordHash     String? // null when only OAuth-linked
  dob              DateTime @db.Date
  ageVerifiedAdult Boolean  @default(false)
  emailVerified    Boolean  @default(false)
  isSuspended      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  role UserRole @default(member)

  oauthAccounts   OAuthAccount[]
  sessions        Session[]
  covenants       CovenantSignature[]
  faithProfile    FaithProfile?
  profile         Profile?
  photos          Photo[]
  moderationItems ModerationItem[]

  sentMessages           Message[]               @relation("MessageSender")
  receivedMessages       Message[]               @relation("MessageRecipient")
  reportsSubmitted       Report[]                @relation("ReportReporter")
  reportsAgainst         Report[]                @relation("ReportReported")
  blocksAuthored         Block[]                 @relation("BlockBlocker")
  blocksAgainst          Block[]                 @relation("BlockBlocked")
  reviewedQueueItems     ModerationQueueItem[]   @relation("QueueReviewer")
  accountDeletion        AccountDeletionRequest? @relation("UserDeletion")
  moderationActionsTaken ModerationAction[]      @relation("ActionActor")

  // Soft-delete marker: BLE-10 sets this on `DELETE /me`. Read-paths must
  // filter `deletedAt IS NULL` to hide the user from feeds and chat lists.
  deletedAt DateTime?

  // BLE-129 — quiet-hours config (Holy Code §7.4 default = Sunday 09:00–11:30
  // local). `timezone` is an IANA name; `quietHours` is the JSON-serialized
  // QuietHoursConfig.windows array. Both nullable so legacy users keep working
  // until they set a timezone via /me settings; the predicate treats a missing
  // config as "never quiet".
  timezone   String?
  quietHours Json?

  @@index([email])
  @@index([deletedAt])
}

model OAuthAccount {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    OAuthProvider
  providerSub String
  createdAt   DateTime      @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

// Holy Code of Conduct acceptance. Versioned. Pastor signs the canonical text.
model CovenantSignature {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  @@unique([userId, version])
  @@index([userId])
}

model FaithProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  denomination     Denomination
  churchAttendance ChurchAttendance
  baptized         Boolean
  marriageIntent   MarriageIntent
  spiritualGifts   SpiritualGift[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Profile {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  gender         Gender
  city           String
  countryCode    String         @db.Char(2)
  bio            String?
  bioApproved    Boolean        @default(false)
  onboardingStep OnboardingStep @default(age_gate)

  // BLE-124 — onboarding questionnaire v1 fields. All optional from the
  // schema's POV so legacy rows survive; the API enforces required-when-
  // dating gates (Q3 seeking, Q6 marriageOpen).
  intent                Intent?
  seeking               Seeking?
  tradition             Tradition?
  traditionOther        String?
  walkStage             WalkStage?
  marriageOpen          MarriageOpen?
  welcomedTags          WelcomedTag[] @default([])
  // Per-tag opt-in. Privacy-by-default: any tag absent from the JSON is
  // treated as `false`. Migration test asserts default `{}` (no public
  // surfacing) — see services/matching + apps/api privacy lints.
  welcomedTagVisibility Json          @default("{}")
  practiceTags          PracticeTag[] @default([])
  // Q9 bio seed. Stored separately from `bio` so the moderation history is
  // distinct, and so a flagged seed never silently becomes a published bio.
  bioSeed               String?
  bioSeedApproved       Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  q3RedirectEvents Q3RedirectEvent[]

  @@index([countryCode, city])
  @@index([intent])
}

// BLE-124 — Q3 same-sex redirect audit row. Created when a dating-intent
// user picks the same-sex option. The user's `Profile.seeking` is set to
// `same_sex` only as a transient flag; the redirect outcome (`accept_reroute`
// → `intent=friendship`, `closed_by_user` → soft-delete request) drives all
// downstream behavior. No same-sex match-preference row is ever written.
model Q3RedirectEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  profile   Profile           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  outcome   Q3RedirectOutcome
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
}

model Photo {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey       String      @unique
  position         Int
  status           PhotoStatus @default(uploaded)
  faceCount        Int?
  faceAreaRatio    Float?
  rejectionReasons String[]    @default([])
  unsafeLabels     String[]    @default([])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, position])
}

model ModerationItem {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String?            @db.Uuid
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind         ModerationKind
  subjectId    String? // photo id, message id, etc.
  rawContent   String? // text or storage ref
  decision     ModerationDecision
  status       ModerationStatus   @default(pending)
  categories   String[]           @default([])
  provider     String
  rawScore     Float?
  reviewerNote String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// Chat message. Persisted only when delivery decision is delivered or queued.
// Blocked messages are never persisted to Message; they only land in the
// ModerationQueueItem audit row (status = rejected).
model Message {
  id              String               @id @default(uuid()) @db.Uuid
  threadId        String               @db.Uuid
  senderUserId    String               @db.Uuid
  sender          User                 @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipientUserId String               @db.Uuid
  recipient       User                 @relation("MessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  body            String
  attachmentIds   String[]             @default([])
  status          MessageStatus
  queueItemId     String?              @db.Uuid
  queueItem       ModerationQueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  deliveredAt     DateTime?

  @@index([threadId, createdAt])
  @@index([recipientUserId, status])
}

// Audit + review queue row for any moderation outcome that wasn't a clean
// allow. Includes blocked content (status=rejected by system) so operators
// can spot-check false positives.
model ModerationQueueItem {
  id              String                @id @default(uuid()) @db.Uuid
  kind            ModerationQueueKind
  status          ModerationQueueStatus @default(pending_review)
  senderUserId    String?               @db.Uuid
  recipientUserId String?               @db.Uuid
  threadId        String?               @db.Uuid
  uploadId        String?               @db.Uuid
  storageKey      String?
  bodyText        String?
  attachmentIds   String[]              @default([])
  decision        String // 'allow' | 'block' | 'queue'
  reasons         String[]              @default([])
  flags           String[]              @default([])
  rawScores       Json
  reviewerNote    String?
  reviewerUserId  String?               @db.Uuid
  reviewer        User?                 @relation("QueueReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())

  messages Message[]

  @@index([status, createdAt])
  @@index([senderUserId])
}

model Report {
  id                 String       @id @default(uuid()) @db.Uuid
  reporterUserId     String       @db.Uuid
  reporter           User         @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUserId     String       @db.Uuid
  reported           User         @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  threadId           String?      @db.Uuid
  messageId          String?      @db.Uuid
  reason             ReportReason
  freeform           String?
  // BLE-10 triage fields. Safe defaults so existing BLE-9 inserts are unaffected.
  severity           Int          @default(0)
  status             ReportStatus @default(open)
  resolvedAt         DateTime?
  resolvedByUserId   String?      @db.Uuid
  moderationActionId String?      @db.Uuid
  createdAt          DateTime     @default(now())

  evidenceFreezes   EvidenceFreeze[]   @relation("FreezeReport")
  moderationActions ModerationAction[] @relation("ActionReport")

  @@index([reportedUserId, createdAt])
  @@index([reporterUserId])
  @@index([status, severity, createdAt])
}

model Block {
  blockerUserId String   @db.Uuid
  blocker       User     @relation("BlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUserId String   @db.Uuid
  blocked       User     @relation("BlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

// BLE-10 — server-side hold on a chat thread referenced by an open report.
// Chat redaction/delete paths MUST consult `EvidenceFreeze` before purging
// any message in the thread; freezes outlive account deletion.
model EvidenceFreeze {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  report    Report   @relation("FreezeReport", fields: [reportId], references: [id], onDelete: Cascade)
  threadId  String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([threadId, expiresAt])
  @@index([expiresAt])
}

// BLE-10 — moderation action recorded by Pastor or CEO from the T&S queue.
// Persisted for audit; ban-evasion detection uses these rows even after
// related accounts are hard-deleted.
model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  reportId    String               @db.Uuid
  report      Report               @relation("ActionReport", fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String               @db.Uuid
  actor       User                 @relation("ActionActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  kind        ModerationActionKind
  notes       String?
  appliedAt   DateTime             @default(now())

  @@index([reportId])
  @@index([actorUserId, appliedAt])
}

// BLE-10 — GDPR + CCPA. Soft-delete is immediate; hard-delete worker runs
// 30 days later (or 0 days when expedited). Frozen chat threads are
// preserved past the user's hard-delete date and purged when the freeze
// expires.
model AccountDeletionRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @unique @db.Uuid
  user                  User                  @relation("UserDeletion", fields: [userId], references: [id], onDelete: Cascade)
  status                AccountDeletionStatus @default(soft_deleted)
  expedited             Boolean               @default(false)
  requestedAt           DateTime              @default(now())
  softDeletedAt         DateTime?
  hardDeleteScheduledAt DateTime
  hardDeletedAt         DateTime?
  cancelledAt           DateTime?

  @@index([status, hardDeleteScheduledAt])
}

// BLE-98 — transient verse cache (7-day minimum TTL).
// Hard rule per BLE-30 / BLE-84: never store verse text in the calendar
// table or on the client. Source-of-truth is upstream (Sabda / Biblica);
// this table is rebuilt on demand and purged when expired.
model VerseCache {
  ref         String   @db.Text
  translation String   @db.Text
  text        String   @db.Text
  attribution String   @db.Text
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@id([ref, translation])
  @@index([expiresAt])
}
