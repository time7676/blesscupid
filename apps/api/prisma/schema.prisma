// BlessCupid v1 API — Prisma schema
// Postgres. UUID PKs. v1-restart hard reset (drops legacy pastor-mode/kyc/coin/encryption/quiet-hours).
// Companion plan: ~/.claude/plans/i-think-we-need-misty-eclipse.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Enums
// =====================================================================

enum Role {
  member
  admin
}

enum Locale {
  en
  id
}

enum Gender {
  male
  female
}

enum Tradition {
  catholic
  protestant
  orthodox
  nondenom
  other
}

enum WalkStage {
  seeking
  growing
  rooted
}

enum MarriageIntent {
  yes
  maybe
  no
}

enum ProximityHint {
  near
  same_city
  different_city
}

enum PhotoStatus {
  uploaded
  processing
  approved
  rejected
}

enum MessageKind {
  text
  verse_share
}

enum MessageStatus {
  delivered
  queued
  blocked
}

enum DecisionKind {
  pass
  like
  super_like
}

enum VerseUsedFor {
  chat_anchor
  status
}

enum NotificationKind {
  match
  message
  like
  verification
  status
  other
}

enum SubscriptionTier {
  free
  blessplus
}

enum SubscriptionStatus {
  active
  trialing
  cancelled
  expired
  payment_failed
  grace_period
}

enum SubscriptionCycle {
  weekly
  monthly
  quarterly
  yearly
}

enum ReportReason {
  sexual_content
  harassment
  fake_profile
  underage
  hate_or_harassment
  self_harm_or_crisis
  spam
  other
}

enum ReportStatus {
  open
  under_review
  resolved
}

enum ModerationDecision {
  allow
  review
  block
}

enum ModerationKind {
  text_bio
  text_message
  photo
  status_verse
}

enum OnboardingRejectionReason {
  seeking_same_sex
  age_under_18
  banned_user
}

enum VerificationStatus {
  pending
  approved
  rejected
  expired
}

enum PastorApprovalKind {
  verse_seed
  banned_phrases
  covenant
}

enum AuthProvider {
  apple
  google
}

enum PasswordResetStatus {
  pending
  used
  expired
}

// =====================================================================
// Auth + identity
// =====================================================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  phoneNumber         String?   @unique
  passwordHash        String?
  dob                 DateTime  @db.Date
  ageVerifiedAdult    Boolean   @default(false)
  role                Role      @default(member)
  isSuspended         Boolean   @default(false)
  deletedAt           DateTime?
  onboardingCompleted Boolean   @default(false)
  timezone            String    @default("UTC")
  localePreference    Locale    @default(en)
  countryCode         String?   @db.Char(2)
  consentedAt         DateTime?
  consentVersion      String?
  consentLocale       Locale?
  consentIpHash       String?
  emailVerifiedAt     DateTime?
  lastActiveAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  oauthAccounts          OAuthAccount[]
  sessions               Session[]
  passwordResets         PasswordReset[]
  covenantSignatures     CovenantSignature[]
  profile                Profile?
  photos                 Photo[]
  verificationSubmissions VerificationSubmission[]
  decisionsAsViewer      MatchDecision[]      @relation("decisions_viewer")
  decisionsAsCandidate   MatchDecision[]      @relation("decisions_candidate")
  matchesAsA             Match[]              @relation("match_a")
  matchesAsB             Match[]              @relation("match_b")
  messagesSent           Message[]            @relation("messages_sender")
  verseHistory           UserVerseHistory[]
  statusVerse            StatusVerse?
  blocksMade             Block[]              @relation("blocks_blocker")
  blocksReceived         Block[]              @relation("blocks_blocked")
  reportsFiled           Report[]             @relation("reports_reporter")
  reportsReceived        Report[]             @relation("reports_reported")
  pushTokens             PushToken[]
  notifications          Notification[]
  subscription           UserSubscription?
  paymentTransactions    PaymentTransaction[]
  dailyQuotas            DailyQuota[]

  @@index([deletedAt])
  @@index([countryCode])
  @@index([lastActiveAt])
}

model OAuthAccount {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  provider    AuthProvider
  providerSub String
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  refreshTokenHash String   @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  userAgent       String?
  ipHash          String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  otpHash   String
  status    PasswordResetStatus @default(pending)
  attempts  Int                 @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model CovenantSignature {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  version   String
  acceptedAt DateTime @default(now())
  ipHash    String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// =====================================================================
// Profile + photos + verification
// =====================================================================

model Profile {
  userId             String   @id @db.Uuid
  displayName        String
  gender             Gender
  seeking            Gender
  city               String
  countryCode        String   @db.Char(2)
  // PRIVATE: server-only, never serialized to API responses
  lat                Float
  lng                Float
  homeChurchName     String?
  churchLat          Float?
  churchLng          Float?
  // /PRIVATE
  bio                String?
  bioApprovedAt      DateTime?
  tradition          Tradition
  walkStage          WalkStage
  marriageIntent     MarriageIntent
  whimsicalAnswers   Json     @default("{}")
  isVerified         Boolean  @default(false)
  onboardingStep     Int      @default(0)
  pausedUntil        DateTime?
  hideFromUnverified Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([countryCode, gender, seeking])
  @@index([isVerified])
}

model Photo {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  position             Int
  storageKey           String
  status               PhotoStatus @default(uploaded)
  faceCount            Int?
  faceAreaRatio        Float?
  rejectionReasons     String[]    @default([])
  unsafeLabels         String[]    @default([])
  exifStripped         Boolean     @default(false)
  variantsGeneratedAt  DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Position uniqueness enforced via DEFERRABLE INITIALLY DEFERRED constraint
  // applied in raw-SQL migration (allows reorder swaps within single tx)
  @@unique([userId, position])
  @@index([userId])
  @@index([status])
}

model VerificationSubmission {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  selfieKey       String
  faceMatchScore  Float?
  status          VerificationStatus @default(pending)
  decidedAt       DateTime?
  decidedByUserId String?            @db.Uuid
  rejectionReason String?
  // selfieKey auto-deleted from S3 by selfie-cleanup worker 24h after decidedAt
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// =====================================================================
// Matching
// =====================================================================

model MatchDecision {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  candidateUserId   String       @db.Uuid
  decision          DecisionKind
  day               String       // YYYY-MM-DD in viewer's timezone
  createdAt         DateTime     @default(now())

  viewer    User @relation("decisions_viewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate User @relation("decisions_candidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([userId, candidateUserId])
  @@index([userId, createdAt])
  @@index([candidateUserId, decision])
  @@index([userId, day])
}

// Match = denormalized cache of mutual non-pass decisions, written transactionally
// in matching.service.recordDecision() within the same tx as MatchDecision upsert.
// userAId < userBId enforced as canonical pair ordering.
model Match {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @db.Uuid
  userBId   String   @db.Uuid
  thread    Thread?
  createdAt DateTime @default(now())

  userA User @relation("match_a", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("match_b", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
}

model DailyQuota {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  day         String   // YYYY-MM-DD in viewer's timezone
  likesUsed   Int      @default(0)
  supersUsed  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// =====================================================================
// Threads + chat
// =====================================================================

model Thread {
  id            String        @id @default(uuid()) @db.Uuid
  matchId       String        @unique @db.Uuid
  lastMessageAt DateTime?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  match    Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  anchor   ThreadAnchor?
  messages Message[]

  @@index([lastMessageAt])
}

model ThreadAnchor {
  threadId    String  @id @db.Uuid
  verseRef    String
  verseText   String
  attribution String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Message {
  id              String        @id @default(uuid()) @db.Uuid
  threadId        String        @db.Uuid
  senderUserId    String        @db.Uuid
  body            String
  kind            MessageKind   @default(text)
  verseRef        String?
  clientMessageId String        @db.Uuid
  status          MessageStatus @default(delivered)
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation("messages_sender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@unique([threadId, clientMessageId])
  @@index([threadId, createdAt])
  @@index([senderUserId])
}

// =====================================================================
// Verse
// =====================================================================

model VerseCache {
  id          String   @id @default(uuid()) @db.Uuid
  ref         String
  translation String
  text        String
  attribution String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([ref, translation])
  @@index([expiresAt])
}

// Per-user verse de-dup tracker. Separate cones for chat_anchor vs status (no cross-blocking).
model UserVerseHistory {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  verseRef  String
  usedFor   VerseUsedFor
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Primary index supports window-scan dedup query:
  // WHERE userId IN (a,b) AND usedFor=? AND createdAt > now()-90d
  @@index([userId, usedFor, createdAt])
  @@index([verseRef])
}

model StatusVerse {
  userId      String    @id @db.Uuid
  verseRef    String
  verseText   String
  attribution String
  setAt       DateTime  @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([setAt])
}

// =====================================================================
// Moderation
// =====================================================================

model ModerationQueueItem {
  id              String             @id @default(uuid()) @db.Uuid
  kind            ModerationKind
  decision        ModerationDecision
  reasons         String[]           @default([])
  flags           String[]           @default([])
  rawScores       Json?
  senderUserId    String?            @db.Uuid
  bodyText        String?
  refId           String?            @db.Uuid // Photo.id or Message.id
  reviewerUserId  String?            @db.Uuid
  reviewedAt      DateTime?
  resolution      String?
  createdAt       DateTime           @default(now())

  @@index([decision, reviewedAt])
  @@index([senderUserId])
  @@index([createdAt])
}

model Report {
  id                String       @id @default(uuid()) @db.Uuid
  reporterUserId    String?      @db.Uuid
  reporterDeleted   Boolean      @default(false)
  reportedUserId    String       @db.Uuid
  reason            ReportReason
  detail            String?
  threadId          String?      @db.Uuid
  messageId         String?      @db.Uuid
  status            ReportStatus @default(open)
  reviewerUserId    String?      @db.Uuid
  reviewedAt        DateTime?
  resolution        String?
  createdAt         DateTime     @default(now())

  reporter User? @relation("reports_reporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reported User  @relation("reports_reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId])
  @@index([status, createdAt])
}

model Block {
  blockerUserId String   @db.Uuid
  blockedUserId String   @db.Uuid
  createdAt     DateTime @default(now())

  blocker User @relation("blocks_blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("blocks_blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

// =====================================================================
// Notifications + push
// =====================================================================

model PushToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  token       String   @unique
  platform    String // 'ios' | 'android' | 'web'
  appVersion  String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  kind      NotificationKind
  title     String
  body      String
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// =====================================================================
// Subscription + payments
// =====================================================================

model SubscriptionPlan {
  id              String            @id @default(uuid()) @db.Uuid
  tier            SubscriptionTier
  cycle           SubscriptionCycle
  priceIdr        Int
  xenditPlanId    String?
  features        Json              @default("{}")
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tier, cycle])
}

model UserSubscription {
  userId            String              @id @db.Uuid
  tier              SubscriptionTier    @default(free)
  status            SubscriptionStatus  @default(active)
  cycle             SubscriptionCycle?
  startedAt         DateTime?
  expiresAt         DateTime?
  trialEndsAt       DateTime?
  xenditRecurringId String?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([trialEndsAt])
}

model PaymentTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  type             String // 'subscription'
  amountIdr        Int
  status           String // 'pending'|'paid'|'failed'|'refunded'|'cancelled'
  method           String?
  xenditInvoiceId  String?  @unique
  xenditChargeId   String?  @unique
  xenditRecurringId String?
  paidAt           DateTime?
  failedAt         DateTime?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// =====================================================================
// Onboarding + audit
// =====================================================================

// User row HARD-DELETED on Q3 same-sex hard-reject (NOT soft-delete + 30d).
// Only emailHash retained for audit + abuse-prevention (block re-signup with same email
// after a Q3 reject? — currently no, but emailHash supports future rule.)
model OnboardingRejection {
  id        String                    @id @default(uuid()) @db.Uuid
  emailHash String
  reason    OnboardingRejectionReason
  closedAt  DateTime                  @default(now())

  @@index([emailHash])
  @@index([reason, closedAt])
}

// CI deploy gate: production releases blocked unless required PastorApproval rows exist.
// Examples: { kind: 'verse_seed', version: 'v1' } or { kind: 'banned_phrases', version: 'v1' }
model PastorApproval {
  id          String             @id @default(uuid()) @db.Uuid
  kind        PastorApprovalKind
  version     String
  approvedBy  String             @db.Uuid
  approvedAt  DateTime           @default(now())
  notes       String?

  @@unique([kind, version])
  @@index([approvedAt])
}

// =====================================================================
// Waitlist (untouched from existing — pre-launch teaser site)
// =====================================================================

model Waitlist {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  intent       String?
  city         String?
  locale       String?   @db.Char(2)
  consentedAt  DateTime  @default(now())
  status       String    @default("signed_up")
  utmCampaign  String?
  utmSource    String?
  utmMedium    String?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}
