# BlessCupid mobile — Expo Go env template.
# Copy to apps/mobile/.env and restart Metro after editing. Only EXPO_PUBLIC_*
# values are inlined into the JS bundle.

# API base URL (Fly origin per BLE-118, or local NestJS dev server).
# Phones on the same Wi-Fi need your LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=https://api.blesscupid.com
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Set to 1 only for offline UI walk-throughs without a backend. Mock returns
# happy-path JSON for every route. Default off — even in dev, real fetches
# go through unless this flag is explicitly 1.
EXPO_PUBLIC_USE_API_MOCK=

# Firebase (web SDK — works in Expo Go). Pull from Firebase console >
# Project settings > General > Your apps > Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Observability (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
