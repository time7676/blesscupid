{
  "name": "@blesscupid/mobile",
  "version": "0.1.0",
  "description": "BlessCupid mobile app (Expo / React Native)",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "storybook": "EXPO_PUBLIC_ONBOARDING_STORYBOOK_ENABLED=1 expo start",
    "storybook:ios": "EXPO_PUBLIC_ONBOARDING_STORYBOOK_ENABLED=1 expo run:ios",
    "storybook:android": "EXPO_PUBLIC_ONBOARDING_STORYBOOK_ENABLED=1 expo run:android",
    "lint": "echo 'lint: mobile (noop until eslint configured)'",
    "lint:moderation-copy": "node scripts/lint-moderation-copy.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/lint-moderation-copy.test.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react-native": "^2.7.3",
    "@babel/runtime": "^7.29.2",
    "@blesscupid/shared": "workspace:*",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.0",
    "@sentry/react-native": "^8.9.2",
    "aws-amplify": "^6.16.4",
    "expo": "~51.0.0",
    "expo-apple-authentication": "~6.4.2",
    "expo-auth-session": "~5.5.0",
    "expo-camera": "^15.0.16",
    "expo-font": "^12.0.10",
    "expo-image-picker": "~15.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "firebase": "^12.12.1",
    "posthog-react-native": "^4.43.10",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-otp-verify": "^1.2.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "~4.10.5",
    "react-native-screens": "~3.31.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "^7.6.20",
    "@storybook/addon-ondevice-controls": "^7.6.20",
    "@storybook/react-native": "^7.6.20",
    "@types/react": "~18.2.79",
    "typescript": "^5.6.3"
  }
}
