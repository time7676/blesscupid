# BlessCupid VPS prod .env. Place at /srv/blesscupid/.env (mode 600).
# Never commit real secrets. Source this from docker-compose `env_file`.

# === Database ===
# Shared Postgres lives at hostname `postgres` on the `internal` docker network.
DATABASE_URL=postgresql://blesscupid:${POSTGRES_BLESSCUPID_PASSWORD}@postgres:5432/blesscupid?schema=public
POSTGRES_BLESSCUPID_PASSWORD=replace-me

# === Redis ===
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=replace-me

# === JWT ===
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# === OAuth ===
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=

# === Moderation ===
# Gemini = default (cheapest). Switch to openai by setting TEXT_MODERATION_PROVIDER=openai.
TEXT_MODERATION_PROVIDER=gemini
GEMINI_API_KEY=
PERSPECTIVE_API_KEY=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Cloudflare R2 — photo storage ===
PHOTO_BUCKET=blesscupid-photos
S3_ENDPOINT=https://7e20a349cdb3379d8a786faaa993b371.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# === Cloudflare R2 — backups (separate bucket) ===
BACKUP_BUCKET=blesscupid-backups

# === Firebase admin SDK (Phone auth verification) ===
# Base64-encode the service-account JSON: cat sa.json | base64 | tr -d '\n'
FIREBASE_ADMIN_CREDENTIALS_JSON=

# === Observability ===
SENTRY_DSN=
POSTHOG_API_KEY=

# === Node ===
NODE_ENV=production
PORT=3000
